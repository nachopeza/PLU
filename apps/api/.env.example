# Copia este archivo a .env y rellénalo. El archivo .env NO se sube a git.

# Puerto de la API
PORT=8787

# Carpeta donde viven la base de datos, fotos y plantillas (en producción: un volumen persistente)
PLU_DATA_DIR=./data

# URL pública de la web (la usará el QR del carné para apuntar a /verificar)
PLU_PUBLIC_URL=http://localhost:8787

# Usuario maestro de la intranet (rol admin). Cámbialo siempre en producción.
PLU_ADMIN_USERNAME=
PLU_ADMIN_PASSWORD=

# Envío de correo con Resend (carné, avisos). Sin esto, simplemente no se envía nada.
RESEND_API_KEY=
PLU_EMAIL_FROM=

# Claves de cifrado (64 caracteres hexadecimales cada una). En local se generan solas en data/secretos.json.
# En producción son OBLIGATORIAS. Genera cada una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si las pierdes, los DNI guardados no se pueden recuperar: guárdalas en un gestor de contraseñas.
PLU_CLAVE_CIFRADO=
PLU_CLAVE_HMAC=
